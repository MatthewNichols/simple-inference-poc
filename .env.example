# Copy to .env and fill in before `docker compose up`.
API_KEY=change-me
OLLAMA_MODEL=qwen2.5:1.5b

# Port the app listens on. Coolify publishes this exact number on the host
# to route to it, so pick something unlikely to already be taken by another
# app on the same host (3000 commonly is - e.g. Linkwarden defaults to it).
APP_PORT=3000
