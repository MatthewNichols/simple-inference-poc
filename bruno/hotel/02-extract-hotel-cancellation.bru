meta {
  name: Extract Hotel (cancellation notice, expect 422)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/extract/hotel
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "sourceType": "email",
    "contentBase64": ""
  }
}

tests {
  test("responds 422 with a NON_RESERVATION_DOCUMENT error", function () {
    expect(res.status).to.equal(422);
    expect(res.body.error.code).to.equal("NON_RESERVATION_DOCUMENT");
    expect(res.body.error.reason).to.equal("cancellation");
  });
}
